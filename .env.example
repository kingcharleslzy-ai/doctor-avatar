# MedFlow / Doctor Avatar
# 当前数字人主链路只使用豆包端到端实时语音。

APP_HOST=127.0.0.1
APP_PORT=8000

# 站点主体与备案展示
SITE_BRAND_NAME=MedFlow
SITE_LEGAL_NAME=杭州富阳启临数智科技工作室
SITE_ICP_BEIAN_NO=

# 运维控制台
CONSOLE_AUTH_MODE=basic
CONSOLE_USERNAME=
CONSOLE_PASSWORD=

# 豆包端到端实时语音 API Key 接入
DOUBAO_REALTIME_ENABLED=true
DOUBAO_REALTIME_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_REALTIME_API_KEY=
DOUBAO_REALTIME_RESOURCE_ID=volc.speech.dialog
DOUBAO_REALTIME_MODEL=1.2.1.1
DOUBAO_REALTIME_SPEAKER=zh_male_yunzhou_jupiter_bigtts
DOUBAO_REALTIME_SPEECH_RATE=0
DOUBAO_REALTIME_LOUDNESS_RATE=0

# O / O2.0 模型人设配置
DOUBAO_REALTIME_BOT_NAME=MedFlow
DOUBAO_REALTIME_SYSTEM_ROLE=你是 MedFlow 医疗 AI 信息化工作室提供的医疗健康科普语音助手。你只提供健康科普、就医准备、检查流程解释和术前术后注意事项的通俗说明；不做诊断结论，不替代医生面诊，不承诺疗效。
DOUBAO_REALTIME_SPEAKING_STYLE=沉稳、清晰、专业、温和，回答尽量简洁，适合医疗机构患者宣教场景。
DOUBAO_REALTIME_OPENING_REMARK=你好，我是李医生。你先说一下现在最不舒服的症状，我来一步一步问清楚。
DOUBAO_REALTIME_DIALOG_ID=
DOUBAO_REALTIME_INPUT_MODE=keep_alive
DOUBAO_REALTIME_STRICT_AUDIT=true
DOUBAO_REALTIME_AUDIT_RESPONSE=这个问题需要由线下医生结合检查结果判断，我可以先帮你整理需要补充的信息。

# ASR 与对话体验
DOUBAO_REALTIME_END_SMOOTH_WINDOW_MS=1200
DOUBAO_REALTIME_ENABLE_ASR_TWOPASS=true
DOUBAO_REALTIME_HOTWORDS=鼻炎,过敏性鼻炎,鼻窦炎,鼻塞,喷嚏,鼻痒,流涕,鼻内镜,过敏原,免疫治疗,腺样体,鼻中隔,耳鸣,咽炎
DOUBAO_REALTIME_CORRECT_WORDS=
DOUBAO_REALTIME_ENABLE_LOUDNESS_NORM=true
DOUBAO_REALTIME_ENABLE_CONVERSATION_TRUNCATE=true
DOUBAO_REALTIME_ENABLE_USER_QUERY_EXIT=true

# 内置联网搜索默认关闭。医疗场景优先走本地资料库/RAG，需要实时搜索时再单独开启并配置搜索 API Key。
DOUBAO_REALTIME_ENABLE_WEBSEARCH=false
DOUBAO_REALTIME_WEBSEARCH_TYPE=web_summary
DOUBAO_REALTIME_WEBSEARCH_API_KEY=
DOUBAO_REALTIME_WEBSEARCH_BOT_ID=
DOUBAO_REALTIME_WEBSEARCH_RESULT_COUNT=5
DOUBAO_REALTIME_WEBSEARCH_NO_RESULT_MESSAGE=没有检索到可靠的实时资料，本轮先依据已确认的院内资料继续说明。
DOUBAO_REALTIME_LOCATION_CITY=杭州

# 医生资料库
DOCTOR_MEMORY_DB_PATH=
DOCTOR_MEMORY_BOOTSTRAP=true
CONSOLE_MEMORY_WRITE_ENABLED=false

# 鼻敏智诊证据库
RHINITIS_EVIDENCE_DB_PATH=
RHINITIS_EVIDENCE_REVIEW_ENABLED=false
RHINITIS_EVIDENCE_SEED_SNAPSHOT_ENABLED=true
RHINITIS_AI_REVIEW_MODEL=gpt-5.5
RHINITIS_AI_REVIEW_DIR=
OPENAI_API_KEY=
OPENAI_BASE_URL=
