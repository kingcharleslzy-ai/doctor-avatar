TTS_FALLBACK_PROVIDER=openai
ALIYUN_TTS_MODEL=qwen-tts-latest
ALIYUN_TTS_VOICE=Ethan
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_INSTRUCTIONS=请用沉稳、成熟、专业、温和的中文男医生语气说话，语速平稳，吐字清晰，不要夸张表演。
