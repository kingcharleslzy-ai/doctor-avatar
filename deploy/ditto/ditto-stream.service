[Unit]
Description=Ditto Streaming WebSocket Service
After=network.target

[Service]
User=charles
WorkingDirectory=/home/charles
ExecStart=/home/charles/miniconda3/envs/ditto/bin/python /home/charles/ditto_stream_service.py
Restart=on-failure
RestartSec=5
Environment=HOME=/home/charles

[Install]
WantedBy=multi-user.target
